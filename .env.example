# Environment -----------------------------------------------------------------
# options: dev| prod
ENV=dev

# Dev - Local Filesystem-------------------------------------------------------
LOCAL_BRONZE_PATH=./data/bronze
LOCAL_CATALOG_PATH=./data/catalog

# Prod - AWS S3 ----------------------------------------------------------------
# S3 bucket name for Bronze Layer storage
S3_BUCKET_NAME=your-nba-bronze-bucket

# AWS Glue Data Catalog database name
AWS_GLUE_DATABASE=nba_bronze

# AWS region for S3 and Glue
AWS_REGION=us-east-1

# IAM credentials (if not using default AWS credentials provider chain)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key